
{
  "name": "mara-browser",
  "version": "1.0.0",
  "description": "Mara — a customizable Chromium desktop browser",
  "main": "main.js",
  "author": "Mara Project",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mara.browser",
    "productName": "Mara Browser",
    "asar": true,
    "files": [
      "**/*",
      "!release",
      "!node_modules/.cache"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
